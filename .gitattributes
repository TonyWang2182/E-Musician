* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.inc text eol=lf
*.py text eol=lf
*.sh text eol=lf
scripts/cloud/Save-CloudData.ps1 text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
# Unified-diff context contains significant leading/trailing spaces.
*.patch text eol=lf -whitespace
*.wav binary
*.mp3 binary
*.png binary
*.jpg binary
.gitignore text eol=lf
.gitattributes text eol=lf
# Evidence hashes refer to original captured bytes, including line endings.
docs/builds/*.json -text whitespace=cr-at-eol,-blank-at-eof
docs/verification/**/*.json -text whitespace=cr-at-eol,-blank-at-eof
docs/verification/**/*.py.txt -text whitespace=cr-at-eol,-blank-at-eof
docs/review/2026-11-06-cloud-generation/*.json -text whitespace=cr-at-eol,-blank-at-eof
docs/review/2026-11-06-cloud-model-library/**/*.json -text whitespace=cr-at-eol,-blank-at-eof
