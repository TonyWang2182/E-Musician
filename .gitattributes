docs/review/2026-11-06-muscriptor-authorized/**/*.json -text whitespace=cr-at-eol,-blank-at-eof
docs/review/2026-11-07-hybrid-pipeline/**/*.json -text whitespace=cr-at-eol,-blank-at-eof
