{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 / Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {"CMAKE_CONFIGURATION_TYPES": "Debug;Release"},
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    }
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "jobs": 2},
    {"name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release", "jobs": 2}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows-msvc", "configuration": "Debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "windows-release", "configurePreset": "windows-msvc", "configuration": "Release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
