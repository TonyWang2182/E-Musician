{
  "folders": [{ "path": ".", "name": "E-musician / audio-analysis" }],
  "settings": {
    "cmake.configureOnOpen": false,
    "cmake.sourceDirectory": "E:/emusician-analysis-source",
    "cmake.buildDirectory": "E:/emusician-analysis-build"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Analysis: build Release with log",
        "type": "process",
        "command": "python",
        "args": ["-c", "from scripts.dev import Recorder; Recorder('analysis-vscode-build','Release','VS Code explicit build').execute(['cmake','--build','E:/emusician-analysis-build','--config','Release','--parallel','2','--','/p:UseMultiToolTask=true','/p:CL_MPCount=2','/p:EnforceProcessCountAcrossBuilds=true'])"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "Analysis: CTest with log",
        "type": "process",
        "command": "python",
        "args": ["-c", "from scripts.dev import Recorder; Recorder('analysis-vscode-test','Release','VS Code explicit CTest').execute(['ctest','--test-dir','E:/emusician-analysis-build','-C','Release','--output-on-failure'])"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": "test",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [{
      "name": "E-musician 0.9 Analysis / Release",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "E:/emusician-analysis-build/bin/Release/E-musician.exe",
      "args": ["--agent"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "preLaunchTask": "Analysis: build Release with log"
    }]
  }
}
