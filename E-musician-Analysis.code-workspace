{
  "folders": [{ "path": ".", "name": "E-musician / audio-analysis" }],
  "settings": {
    "cmake.configureOnOpen": false,
    "cmake.sourceDirectory": "E:/emusician-analysis-source",
    "cmake.buildDirectory": "E:/emusician-analysis-build"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Analysis: build Release with log",
        "type": "process",
        "command": "python",
        "args": ["scripts/dev_tempo.py", "build"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "Analysis: CTest with log",
        "type": "process",
        "command": "python",
        "args": ["scripts/dev_tempo.py", "ctest"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": "test",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [{
      "name": "E-musician 0.10.0 Tempo / Release",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "E:/emusician-analysis-build/bin-0.10.0/Release/E-musician.exe",
      "args": ["--agent"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "preLaunchTask": "Analysis: build Release with log"
    }]
  }
}
