+        const auto restored = src::src_set_ratio (src_state, 1.0 / ratio);
+
+        if (failedToRead || generated != seekWarmupFrames || restored != 0)
+            return;
+
+        readPosition = static_cast<double> (t);
+        positionIsValid = true;
