+            || ! std::isfinite (ratio) || ratio <= 0.0
+            || ! src::src_is_valid_ratio (1.0 / ratio))
+            return;
+
+        // E-musician patch: a source seek must retain the fractional input
+        // phase. Rounding sourcePosition and then running a continuous SRC
+        // permanently shifts every output sample after that seek.
+        //
+        // Prime from an integer input anchor. The discarded prefix uses a
+        // temporary ratio chosen to end at sourcePosition exactly. Switching
+        // the ratio immediately afterwards preserves SRC's input history and
+        // phase; none of the audible output uses the temporary ratio.
+        //
+        // 256 discarded frames are sufficient for all three pinned sinc
+        // kernels (largest half-filter < 143 input frames, scaled for
+        // downsampling). For extreme upsampling we prime near unity instead
+        // of generating seconds of discarded output at the final ratio.
+        // There is no gcd/alignment-period search and no allocation here.
+        const auto inputSpan = seekWarmupFrames * std::max (1.0, ratio);
+        const auto anchor = static_cast<SampleCount> (std::ceil (sourcePosition - inputSpan));
+        const auto primeRatio = seekWarmupFrames / (sourcePosition - static_cast<double> (anchor));
+
+        if (! src::src_is_valid_ratio (primeRatio))
+            return;
+
+        source->setPosition (anchor);
+        src::src_reset (src_state);
+
